# =============================================================================
# Mutual Fund FAQ Assistant — Frontend (Vercel) Environment Variables
# =============================================================================
# Set these in Vercel Dashboard → Settings → Environment Variables
# =============================================================================

# Railway backend URL (no trailing slash)
# Use BACKEND_URL (server-side only, more secure) or NEXT_PUBLIC_API_URL
BACKEND_URL=https://your-railway-app.up.railway.app
NEXT_PUBLIC_API_URL=https://your-railway-app.up.railway.app

# Admin token for triggering /api/ingest (must match INGEST_ADMIN_TOKEN in Railway)
NEXT_PUBLIC_INGEST_TOKEN=your_ingest_admin_token_here
