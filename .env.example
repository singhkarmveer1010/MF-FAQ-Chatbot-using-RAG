# =============================================================================
# Mutual Fund FAQ Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- LLM Provider (Groq) ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Model Selection ---
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Vector Store ---
VECTOR_STORE_TYPE=chromadb
VECTOR_STORE_PATH=./vectorstore

# --- Retrieval Parameters ---
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.7

# --- Response Parameters ---
MAX_RESPONSE_SENTENCES=3
LLM_TEMPERATURE=0.0

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- CORS (Production) ---
# Comma-separated list of allowed frontend origins.
# REQUIRED in production — set to your Vercel frontend URL.
# Leave blank in local dev (defaults to allow all origins without credentials).
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=

# --- Automated Ingestion Scheduler (GitHub Actions & Local Cron) ---
# 0 5 * * * corresponds to 05:00 UTC (10:30 AM IST) daily
INGESTION_CRON=0 5 * * *
INGESTION_INTERVAL_HOURS=24
INGEST_ADMIN_TOKEN=your_secure_admin_token_here
